###> symfony/framework-bundle ###
APP_ENV=prod
# APP_SECRET is loaded from AWS Secrets Manager at runtime (see services.yaml or .env.local override)
# DO NOT hardcode secrets here. Use: aws secretsmanager get-secret-value --secret-id jyotish/prod/app-secret
APP_SECRET=${APP_SECRET:-change-me-in-prod}
###< symfony/framework-bundle ###

# SWETEST_PATH should be injected from environment or deployment config
SWETEST_PATH=/var/www/api/swetest/src

# Logging (direct to stdout for Docker/ECS CloudWatch integration)
MONOLOG_CHANNEL=jyotish_api

# Database (if needed later)
# DATABASE_URL=mysql://user:password@db-host:3306/jyotish_prod

# Cache (use Redis for distributed caching if scaling)
# REDIS_URL=redis://cache-host:6379

# AWS credentials (leave empty if using ECS Task Role / EC2 Instance Profile)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Bedrock (for future RAG integration)
# BEDROCK_REGION=us-east-1

# Rate limiting / API throttling
API_REQUESTS_PER_MINUTE=100
